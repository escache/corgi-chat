# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase / Postgres (use Supabase connection string for DATABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# LiveKit (Phase 2 — optional video calls)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Giphy (Phase 3)
NEXT_PUBLIC_GIPHY_API_KEY=

# Sentry (Phase 5 — optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Web app origin (used by the desktop client CORS policy)
NEXT_PUBLIC_ORIGIN=
DESKTOP_ALLOWED_ORIGINS=

# Desktop app (Phase 6)
VITE_API_BASE_URL=http://localhost:3000
VITE_WEB_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GIPHY_API_KEY=

# Tauri updater public key (generate with `pnpm tauri signer generate`)
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
